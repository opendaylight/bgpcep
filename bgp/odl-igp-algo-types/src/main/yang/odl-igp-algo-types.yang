module odl-igp-algo-types {
  yang-version 1;
  namespace "urn:opendaylight:yang:igp:algo:types";
  prefix "oiat";

  description
    "YANG model of IGP Algorithm Types IANA registry.

     Copyright (c) 2026 PANTHEON.tech, s.r.o. and others.  All rights reserved.

     This program and the accompanying materials are made available under the
     terms of the Eclipse Public License v1.0 which accompanies this distribution,
     and is available at http://www.eclipse.org/legal/epl-v10.html";

  revision "2026-11-10" {
    description
      "Initial revision";
  }

  import iana-igp-algo-types {
    prefix iiat;
  }

  typedef algo-flex {
    type uint8 {
      range 128..255;
    }
    description
      "IGP Flexible Algorithm Type in IANA IGP Algorithm Types registry";
    reference
      "RFC 9350: IGP Flexible Algorithm";
  }

  typedef algo-type {
    type union {
      type iiat:algo-type;
      type algo-flex;
    }
    description
      "IGP Algorithm Type";
    reference
      "https://www.iana.org/assignments/igp-parameters#igp-algorithm-types";
  }
}

