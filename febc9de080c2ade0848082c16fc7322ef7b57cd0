      "key": {
        "uuid": "009ca28c_5208cd8c",
        "filename": "testtool-util/src/main/java/org/opendaylight/protocol/util/CheckUtil.java",
        "patchSetId": 19
      },
      "lineNbr": 79,
      "author": {
        "id": 9229
      },
      "writtenOn": "2026-09-22T11:26:56Z",
      "side": 1,
      "message": "ConditionAwaiter installs a JVM-global default uncaught-exception handler for the duration of every poll and rethrows whatever lands there, so an unrelated dying thread would fail whichever check happens to be waiting — the old Stopwatch loops never touched global state. Switched the chains to Awaitility.dontCatchUncaughtExceptions(), which restores the previous behaviour.",
      "parentUuid": "f55e5920_420e0818",
      "revId": "febc9de080c2ade0848082c16fc7322ef7b57cd0",
      "serverId": "7fc14799-209e-464c-9743-7a06c2c21a81"
